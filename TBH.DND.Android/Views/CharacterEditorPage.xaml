            <HorizontalStackLayout Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                <Button Text="Save" Command="{Binding SaveCommand}"/>
                <Button Text="Cancel" Command="{Binding CancelCommand}"/>
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>