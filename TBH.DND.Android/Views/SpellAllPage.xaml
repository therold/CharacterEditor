<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:html="clr-namespace:LiteHtmlMaui.Controls;assembly=LiteHtmlMaui"
    x:Class="TBH.DND.Android.Views.SpellAllPage"
    Title="Edit Spells">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding SortOrder}" Clicked="OnSortClicked"/>
        <ToolbarItem Text="Add"  Order="Secondary" Clicked="OnAddClicked" />
        <ToolbarItem Text="Enable All" Order="Secondary" Clicked="OnEnableClicked" />
        <ToolbarItem Text="Disable All" Order="Secondary" Clicked="OnDisableClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Padding="0,0,5,0" Text="Class" FontAttributes="Bold" VerticalOptions="Center" />
            <Picker Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Title="Select class" VerticalOptions="Center" />
            <Label Grid.Row="1" Grid.Column="0" Padding="0,0,5,0" Text="Source" FontAttributes="Bold" VerticalOptions="Center" />
            <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Title="Select source" VerticalOptions="Center" />
            <Entry Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SearchText}" Placeholder="Search spells..." />
        </Grid>
        <CollectionView ItemsSource="{Binding Spells}" SelectionMode="None" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete" Invoked="OnDeleteSwipeItemInvoked" CommandParameter="{Binding .}" BackgroundColor="LightCoral" />
                                <SwipeItem Text="Edit" Invoked="OnEditSwipeItemInvoked" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="8" Margin="4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                        </Border.GestureRecognizers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding LevelDisplay}" FontAttributes="Bold" WidthRequest="55" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" />
                                <Switch Grid.Row="0" Grid.Column="2" HeightRequest="10" IsToggled="{Binding Active}" Toggled="OnActiveToggled"/>

                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"  Margin="8" IsVisible="{Binding IsExpanded}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <html:LiteHtml Grid.Column="0" Html="{Binding Description}" VerticalOptions="Start" HeightRequest="10" Margin="0,0,10,0">
                                        <html:LiteHtml.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                                        </html:LiteHtml.GestureRecognizers>
                                    </html:LiteHtml>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Padding="0,0,3,0" Text="School" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding School}" FontAttributes="Italic" FontSize="12" />
                                        <Label Grid.Row="1" Grid.Column="0" Padding="0,0,3,0" Text="Time" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CastingTime}" FontAttributes="Italic" FontSize="12" />


                                        <Label Grid.Row="2" Grid.Column="0" Padding="0,0,3,0" Text="Range" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Range}" FontAttributes="Italic" FontSize="12" />
                                        <Label Grid.Row="3" Grid.Column="0" Padding="0,0,3,0" Text="Duration" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Duration}" FontAttributes="Italic" FontSize="12" />
                                        <Label Grid.Row="4" Grid.Column="0" Padding="0,0,3,0" Text="Components" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Components}" FontAttributes="Italic" FontSize="12" />
                                        <Label Grid.Row="5" Grid.Column="0" Padding="0,0,3,0" Text="Source" FontAttributes="Bold" FontSize="12" />
                                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding Source}" FontAttributes="Italic" FontSize="12" />
                                    </Grid>
                                </Grid>


                                <!--<html:LiteHtml Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Html="{Binding Description}" IsVisible="{Binding IsExpanded}"  VerticalOptions="Start" Margin="0,0,10,0">
                                    <html:LiteHtml.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                                    </html:LiteHtml.GestureRecognizers>
                                </html:LiteHtml>-->
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
