<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:html="clr-namespace:LiteHtmlMaui.Controls;assembly=LiteHtmlMaui"
    x:Class="TBH.DND.Android.Views.TraitAllPage"
    Title="Traits">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"  Order="Secondary" Clicked="OnAddClicked" />
        <ToolbarItem Text="Enable All" Order="Secondary" Clicked="OnEnableClicked" />
        <ToolbarItem Text="Disable All" Order="Secondary" Clicked="OnDisableClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Entry Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SearchText}" Placeholder="Search traits..." />
        </Grid>
        <CollectionView ItemsSource="{Binding Traits}" SelectionMode="None" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete" Invoked="OnDeleteSwipeItemInvoked" CommandParameter="{Binding .}" BackgroundColor="LightCoral" />
                                <SwipeItem Text="Edit" Invoked="OnEditSwipeItemInvoked" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="8" Margin="4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!--<ColumnDefinition Width="Auto" />-->
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--<Label Grid.Row="0" Grid.Column="0" Text="{Binding LevelDisplay}" FontAttributes="Bold" WidthRequest="55" />-->
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                                <Switch Grid.Row="0" Grid.Column="1" HeightRequest="10" IsToggled="{Binding Active}" Toggled="OnActiveToggled" />
                                <html:LiteHtml Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Html="{Binding Description}" IsVisible="{Binding IsExpanded}"  VerticalOptions="Start" Margin="0,0,10,0">
                                    <html:LiteHtml.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                                    </html:LiteHtml.GestureRecognizers>
                                </html:LiteHtml>
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsExpanded}" Margin="8,4,0,0">
                                    <Label Text="Source: " FontAttributes="Italic" FontSize="12" />
                                    <Label Text="{Binding Source}" FontAttributes="Italic" FontSize="12"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>