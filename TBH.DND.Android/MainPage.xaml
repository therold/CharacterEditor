<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    xmlns:html="clr-namespace:LiteHtmlMaui.Controls;assembly=LiteHtmlMaui"
    x:Class="TBH.DND.Android.MainPage"
    x:Name="Page"
    Title="Character">
    <ScrollView>
        <VerticalStackLayout Padding="12">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="{Binding Character.Name}" FontSize="28" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="..." MinimumHeightRequest="40" MinimumWidthRequest="40" HorizontalOptions="End"/>
            </Grid>
            <Label Text="{Binding Character.Tagline}" FontSize="11" FontAttributes="Italic" Margin="0,0,0,20"/>

            <Grid ColumnDefinitions="*,*" Margin="0,0,0,15">
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Text="Current HP" FontAttributes="Bold"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0,0,30,0" />
                    <Border Grid.Row="0" Grid.Column="1" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.CurrentHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.TempCurrentHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Button Grid.Row="0" Grid.Column="3" Text="✚TEMP" TextColor="Green" Clicked="OnTempCurrentHPClicked" HeightRequest="10" MinimumHeightRequest="40" Margin="5,0,0,0"/>
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="3">
                        <Button Grid.Row="2" Grid.Column="3" Text="━" TextColor="Red" Clicked="OnCurrentHPRemoveClicked" HeightRequest="10" WidthRequest="10"  Margin="5,0,0,0"  MinimumHeightRequest="40" />
                        <Button Grid.Row="2" Grid.Column="4" Text="✚" TextColor="Green" Clicked="OnCurrentHPAddClicked" HeightRequest="10" WidthRequest="10"  MinimumHeightRequest="40" />
                    </HorizontalStackLayout>
                    <Label Grid.Row="1" Grid.Column="0" Text="Total" FontAttributes="Bold"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0,0,30,0" />
                    <Border Grid.Row="1" Grid.Column="1" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.TotalCurrentHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Text="Max HP" FontAttributes="Bold"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0,0,30,0" />
                    <Border Grid.Row="0" Grid.Column="1" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.MaxHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.TempMaxHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="3">
                        <Button Grid.Row="0" Grid.Column="3" Text="✚TEMP" TextColor="Green" Clicked="OnTempMaxHPClicked" HeightRequest="10"  MinimumHeightRequest="40" Margin="5,0,0,0" />
                    </HorizontalStackLayout>

                    <Label Grid.Row="1" Grid.Column="0" Text="Total" FontAttributes="Bold"  HorizontalOptions="Start" VerticalOptions="Center" Margin="0,0,30,0" />
                    <Border Grid.Row="1" Grid.Column="1" Stroke="White" StrokeThickness="1" WidthRequest="40" HeightRequest="40">
                        <Label Text="{Binding Character.TotalMaxHP}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="*, *, *" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="Start">
