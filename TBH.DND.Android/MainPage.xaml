<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    x:Class="TBH.DND.Android.MainPage"
    x:Name="Page"
    Title="Character">

    <ContentPage.ToolbarItems>
        <ToolbarItem StyleId="Item1" Order="Secondary" Text="Add Spell" Clicked="OnAddSpellClicked" />
        <ToolbarItem StyleId="Item1" Order="Secondary" Text="Edit Spell List" Clicked="OnEditSpellListClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="12" Spacing="8">
        <FlexLayout Direction="Row" AlignItems="Center" Margin="8">
            <Label Text="Spells" FontSize="20" VerticalOptions="Center" FlexLayout.Grow="1" />
            <Button Text="..." Clicked="OnHeaderMenuClicked" WidthRequest="44" HeightRequest="36" />
        </FlexLayout>
        <CollectionView ItemsSource="{Binding Spells}" SelectionMode="None" x:Name="SpellsView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Delete" Invoked="OnDeleteSwipeItemInvoked" CommandParameter="{Binding .}" BackgroundColor="LightCoral" />
                                <SwipeItem Text="Edit" Invoked="OnEditSwipeItemInvoked" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="8" Margin="4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <HorizontalStackLayout>
                                    <Label Text="{Binding Level}" FontAttributes="Bold" WidthRequest="36" />
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Class}" FontAttributes="Italic" FontSize="Small" />
                                <Label Text="{Binding Description}" IsVisible="{Binding IsExpanded}" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>